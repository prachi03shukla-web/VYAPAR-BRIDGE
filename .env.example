# ===================================================
# VYAPAR BRIDGE / TILEANCE ENVIRONMENT CONFIGURATION
# ===================================================
# For Vercel or Cloud Run Deployment:
# Add these Environment Variables under your Vercel Project Settings -> Environment Variables.

# Gemini AI Key for Content & Reel Moderation
GEMINI_API_KEY=your_gemini_api_key_here

# App Private Secret Key
APP_PRIVATE_KEY=your_private_key_here

# Optional: Cloudinary Storage Configuration for Video Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_unsigned_preset

# Port Configuration
PORT=3000
NODE_ENV=production

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
